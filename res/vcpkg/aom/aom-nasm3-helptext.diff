diff --git a/build/cmake/aom_optimization.cmake b/build/cmake/aom_optimization.cmake
--- a/build/cmake/aom_optimization.cmake
+++ b/build/cmake/aom_optimization.cmake
@@ -212,11 +212,10 @@ function(test_nasm)
   execute_process(COMMAND ${CMAKE_ASM_NASM_COMPILER} -hf
                   OUTPUT_VARIABLE nasm_helptext)
 
-  if(NOT "${nasm_helptext}" MATCHES "-Ox")
-    message(
-      FATAL_ERROR "Unsupported nasm: multipass optimization not supported.")
-  endif()
-
+  # nasm >= 3.0 prints only the object-format list for `-hf`; the `-Ox`
+  # multipass-optimization flag it used to document there now lives under
+  # `-h` instead. `-Ox` has been supported and default since nasm 2, so the
+  # presence check is obsolete; the object-format checks below still apply.
   if("${AOM_TARGET_CPU}" STREQUAL "x86")
     if("${AOM_TARGET_SYSTEM}" STREQUAL "Darwin")
       if(NOT "${nasm_helptext}" MATCHES "macho32")
